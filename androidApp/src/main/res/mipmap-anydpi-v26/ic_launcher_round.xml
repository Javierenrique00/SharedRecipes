<?xml version="1.0" encoding="utf-8"?>
<!--
  Round twin of ic_launcher.xml. The layers are identical on purpose: an adaptive icon
  is masked by the launcher, which already draws it as a circle where a circle is
  wanted, so there is no separate round artwork to provide. Android only looks for this
  resource because AndroidManifest.xml declares android:roundIcon, and the missing
  monochrome layer is suppressed for the same reason as in ic_launcher.xml.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
